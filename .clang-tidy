# Project baseline: clang-tidy 22.1.7.
# Run only on project-owned translation units with their actual build flags.
InheritParentConfig: false
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-dangling-handle,
  bugprone-sizeof-expression,
  bugprone-suspicious-memory-comparison,
  bugprone-suspicious-memset-usage,
  bugprone-undefined-memory-manipulation,
  bugprone-use-after-move,
  performance-for-range-copy,
  performance-unnecessary-copy-initialization,
  modernize-use-nullptr,
  modernize-use-override
# Establish the baseline before making diagnostics a CI gate.
WarningsAsErrors: ''
HeaderFilterRegex: '(^|[/\\])(include|src|adapters|examples|tests|benchmarks)[/\\]'
ExcludeHeaderFilterRegex: '(^|[/\\])(third_party|_deps|out|build[^/\\]*|cmake-build[^/\\]*)[/\\]'
SystemHeaders: false
FormatStyle: file
