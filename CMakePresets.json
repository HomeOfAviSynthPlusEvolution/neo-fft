{
  "version": 6,
  "configurePresets": [
    {
      "name": "release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/release",
      "cacheVariables": {"CMAKE_BUILD_TYPE": "Release", "BUILD_TESTING": "ON"}
    },
    {
      "name": "core",
      "inherits": "release",
      "binaryDir": "${sourceDir}/build/core",
      "cacheVariables": {"NEO_FFT_BUILD_VAPOURSYNTH": "OFF", "NEO_FFT_BUILD_AVISYNTH": "OFF"}
    },
    {
      "name": "portable",
      "inherits": "core",
      "binaryDir": "${sourceDir}/build/portable",
      "cacheVariables": {"NEO_FFT_HWY_SCALAR_ONLY": "ON"}
    }
  ],
  "buildPresets": [
    {"name": "release", "configurePreset": "release", "jobs": 4},
    {"name": "core", "configurePreset": "core", "jobs": 4},
    {"name": "portable", "configurePreset": "portable", "jobs": 4}
  ],
  "testPresets": [
    {"name": "release", "configurePreset": "release", "output": {"outputOnFailure": true}},
    {"name": "core", "configurePreset": "core", "output": {"outputOnFailure": true}},
    {"name": "portable", "configurePreset": "portable", "output": {"outputOnFailure": true}}
  ]
}
